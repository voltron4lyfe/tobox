              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "done",
              "worked",
              "missed",
              "unplanned",
              "idle"
            ],
            "title": "Verdict"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "rating": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          }
        },
        "type": "object",
        "required": [
          "planned_minutes",
          "actual_minutes",
          "planned_by_quadrant",
          "actual_by_quadrant",
          "important_share",
          "q2_share",
          "plan_adherence",
          "unplanned_minutes",
          "items_planned",
          "items_done",
          "highlight",
          "verdict",
          "date",
          "rating"
        ],
        "title": "DayMetrics"
      },
      "DayOut": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "intention": {
            "type": "string",
            "title": "Intention"
          },
          "planned_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planned At"
          },
          "reflection": {
            "type": "string",
            "title": "Reflection"
          },
          "rating": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "reviewed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed At"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/PlannedItemOut"
            },
            "type": "array",
            "title": "Items"
          },
          "logs": {
            "items": {
              "$ref": "#/components/schemas/LogEntryOut"
            },
            "type": "array",
            "title": "Logs"
          },
          "summary": {
            "$ref": "#/components/schemas/DaySummary"
          }
        },
        "type": "object",
        "required": [
          "date",
          "intention",
          "planned_at",
          "reflection",
          "rating",
          "reviewed_at",
          "items",
          "logs",
          "summary"
        ],
        "title": "DayOut"
      },
      "DaySummary": {
        "properties": {
          "planned_minutes": {
            "type": "integer",
            "title": "Planned Minutes"
          },
          "actual_minutes": {
            "type": "integer",
            "title": "Actual Minutes"
          },
          "planned_by_quadrant": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Planned By Quadrant"
          },
          "actual_by_quadrant": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Actual By Quadrant"
          },
          "important_share": {
            "type": "number",
            "title": "Important Share"
          },
          "q2_share": {
            "type": "number",
            "title": "Q2 Share"
          },
          "plan_adherence": {
            "type": "number",
            "title": "Plan Adherence"
          },
          "unplanned_minutes": {
            "type": "integer",
            "title": "Unplanned Minutes"
          },
          "items_planned": {
            "type": "integer",
            "title": "Items Planned"
          },
          "items_done": {
            "type": "integer",
            "title": "Items Done"
          },
          "highlight": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HighlightStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "done",
              "worked",
              "missed",
              "unplanned",
              "idle"
            ],
            "title": "Verdict"
          }
        },
        "type": "object",
        "required": [
          "planned_minutes",
          "actual_minutes",
          "planned_by_quadrant",
          "actual_by_quadrant",
          "important_share",
          "q2_share",
          "plan_adherence",
          "unplanned_minutes",
          "items_planned",
          "items_done",
          "highlight",
          "verdict"
